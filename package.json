{
  "name": "singlestore-vscode",
  "displayName": "SingleStore Client",
  "description": "SingleStore database client for VS Code: manage connections, browse schemas, run SQL, and get grammar- and schema-aware completions.",
  "version": "0.0.0",
  "publisher": "singlestore",
  "license": "Apache-2.0",
  "icon": "icons/singlestore-light.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/singlestore-labs/singlestore-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[singlestore-sql]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "semanticTokenTypes": [
      { "id": "singlestoreUnknown", "description": "Unclassified SingleStore SQL tokens" },
      { "id": "singlestoreIdentifier", "superType": "variable", "description": "SingleStore SQL identifiers" },
      { "id": "singlestoreString", "superType": "string", "description": "SingleStore SQL strings" },
      { "id": "singlestoreNumber", "superType": "number", "description": "SingleStore SQL numbers" },
      { "id": "singlestoreOperator", "superType": "operator", "description": "SingleStore SQL operators" },
      { "id": "singlestoreKeyword", "superType": "keyword", "description": "SingleStore SQL keywords" },
      { "id": "singlestoreEndOfQuery", "superType": "operator", "description": "SingleStore SQL statement delimiters" },
      { "id": "singlestoreComment", "superType": "comment", "description": "SingleStore SQL comments" }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "singlestoreUnknown": ["source.sql"],
          "singlestoreIdentifier": ["variable.other.sql"],
          "singlestoreString": ["string.quoted.sql"],
          "singlestoreNumber": ["constant.numeric.sql"],
          "singlestoreOperator": ["keyword.operator.sql"],
          "singlestoreKeyword": ["keyword.sql"],
          "singlestoreEndOfQuery": ["punctuation.terminator.statement.sql"],
          "singlestoreComment": ["comment.sql"]
        }
      }
    ],
    "languages": [
      {
        "id": "singlestore-sql",
        "aliases": ["SingleStore SQL", "s2db"],
        "icon": {
          "light": "./icons/singlestore-light.png",
          "dark": "./icons/singlestore-dark.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "singlestore",
          "title": "SingleStore",
          "icon": "./icons/singlestore-activity.svg"
        }
      ]
    },
    "views": {
      "singlestore": [
        {
          "id": "singlestore.connections",
          "name": "Connections",
          "contextualTitle": "SingleStore Connections"
        },
        {
          "id": "singlestore.queryHistory",
          "name": "Query History"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "singlestore.connections",
        "contents": "No SingleStore connections yet. [Add Connection](command:singlestore.addConnection)"
      },
      {
        "view": "singlestore.queryHistory",
        "contents": "Executed queries appear here for this VS Code session."
      }
    ],
    "commands": [
      {
        "command": "singlestore.openConnectionConfig",
        "title": "SingleStore: Preferences",
        "icon": "$(settings-gear)"
      },
      {
        "command": "singlestore.refreshSchema",
        "title": "SingleStore: Refresh Database Schema",
        "icon": "$(refresh)"
      },
      {
        "command": "singlestore.addConnection",
        "title": "SingleStore: Add Connection",
        "icon": "$(add)"
      },
      {
        "command": "singlestore.editConnection",
        "title": "SingleStore: Edit Connection",
        "icon": "$(edit)"
      },
      {
        "command": "singlestore.deleteConnection",
        "title": "SingleStore: Delete Connection",
        "icon": "$(trash)"
      },
      {
        "command": "singlestore.connect",
        "title": "SingleStore: Connect",
        "icon": "$(plug)"
      },
      {
        "command": "singlestore.disconnect",
        "title": "SingleStore: Disconnect",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "singlestore.focusConnections",
        "title": "SingleStore: Show Connections"
      },
      {
        "command": "singlestore.executeQuery",
        "title": "SingleStore: Execute Selection or Current Query",
        "icon": "$(play)"
      },
      {
        "command": "singlestore.executeSelection",
        "title": "SingleStore: Execute Selected SQL"
      },
      {
        "command": "singlestore.executeCurrentQuery",
        "title": "SingleStore: Execute Query at Cursor"
      },
      {
        "command": "singlestore.rerunQuery",
        "title": "SingleStore: Re-execute Query",
        "icon": "$(play)"
      },
      {
        "command": "singlestore.clearQueryHistory",
        "title": "SingleStore: Clear Query History",
        "icon": "$(clear-all)"
      }
    ],
    "keybindings": [
      {
        "command": "singlestore.executeQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && (editorLangId == singlestore-sql || editorLangId == sql)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "singlestore.executeQuery",
          "when": "editorLangId == singlestore-sql || editorLangId == sql",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "singlestore.executeQuery",
          "when": "editorLangId == singlestore-sql || editorLangId == sql",
          "group": "1_modification"
        }
      ],
      "view/title": [
        {
          "command": "singlestore.clearQueryHistory",
          "when": "view == singlestore.queryHistory",
          "group": "navigation"
        },
        {
          "command": "singlestore.addConnection",
          "when": "view == singlestore.connections",
          "group": "navigation"
        },
        {
          "command": "singlestore.openConnectionConfig",
          "when": "view == singlestore.connections",
          "group": "navigation"
        },
        {
          "command": "singlestore.refreshSchema",
          "when": "view == singlestore.connections",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "singlestore.editConnection",
          "when": "view == singlestore.connections && (viewItem == singlestoreConnection || viewItem == singlestoreConnectionActive)",
          "group": "inline@2"
        },
        {
          "command": "singlestore.deleteConnection",
          "when": "view == singlestore.connections && (viewItem == singlestoreConnection || viewItem == singlestoreConnectionActive)",
          "group": "inline@3"
        },
        {
          "command": "singlestore.rerunQuery",
          "when": "view == singlestore.queryHistory && viewItem == singlestoreQueryHistory",
          "group": "inline"
        },
        {
          "command": "singlestore.connect",
          "when": "view == singlestore.connections && viewItem == singlestoreConnection",
          "group": "inline"
        },
        {
          "command": "singlestore.disconnect",
          "when": "view == singlestore.connections && viewItem == singlestoreConnectionActive",
          "group": "inline"
        },
        {
          "command": "singlestore.connect",
          "when": "view == singlestore.connections && viewItem == singlestoreConnection",
          "group": "1_connection"
        },
        {
          "command": "singlestore.editConnection",
          "when": "view == singlestore.connections && (viewItem == singlestoreConnection || viewItem == singlestoreConnectionActive)",
          "group": "1_connection"
        },
        {
          "command": "singlestore.deleteConnection",
          "when": "view == singlestore.connections && (viewItem == singlestoreConnection || viewItem == singlestoreConnectionActive)",
          "group": "1_connection"
        },
        {
          "command": "singlestore.disconnect",
          "when": "view == singlestore.connections && viewItem == singlestoreConnectionActive",
          "group": "1_connection"
        }
      ]
    },
    "configuration": {
      "title": "SingleStore preferences",
      "properties": {
        "singlestore.queryRowLimit": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "description": "Maximum rows retained and displayed per query result. Additional rows are streamed and discarded."
        },
        "singlestore.schemaRefreshInterval": {
          "type": "number",
          "default": 5,
          "enum": [1, 5, 30, 60, 0],
          "enumDescriptions": ["Every minute", "Every 5 minutes", "Every 30 minutes", "Every hour", "Never"],
          "description": "Automatic database schema refresh interval in minutes. 0 disables periodic refresh; initial and manual refreshes remain available."
        },
        "singlestore.filePattern": {
          "type": "string",
          "scope": "application",
          "default": "*.s2db.sql",
          "minLength": 1,
          "description": "File glob for SingleStore SQL completions and language association. Examples: *.s2db.sql, *.sql, **/queries/*.sql. The extension manages the corresponding user files.associations entry without replacing existing associations."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test test/*.test.js",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "singlestore-nodejs": "^1.0.1"
  }
}
