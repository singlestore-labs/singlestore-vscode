{
  "name": "singlestore-vscode",
  "displayName": "SingleStore Language Client",
  "description": "Local WebAssembly SQL completions for SingleStore in VS Code",
  "version": "0.0.0",
  "publisher": "singlestore",
  "license": "Apache-2.0",
  "icon": "icons/singlestore-light.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/singlestore-labs/singlestore-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "singlestore-sql",
        "aliases": ["SingleStore SQL", "s2db"],
        "icon": {
          "light": "./icons/singlestore-light.png",
          "dark": "./icons/singlestore-dark.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "singlestore.openConnectionConfig",
        "title": "SingleStore: Connection Configuration"
      },
      {
        "command": "singlestore.refreshSchema",
        "title": "SingleStore: Refresh Database Schema"
      }
    ],
    "configuration": {
      "title": "SingleStore connection settings",
      "properties": {
        "singlestore.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "SingleStore database host address"
        },
        "singlestore.port": {
          "type": "number",
          "default": 3306,
          "description": "SingleStore database port number"
        },
        "singlestore.username": {
          "type": "string",
          "default": "",
          "description": "Username for SingleStore database authentication"
        },
        "singlestore.password": {
          "type": "string",
          "default": "",
          "description": "Password for SingleStore database authentication"
        },
        "singlestore.databaseName": {
          "type": "string",
          "default": "",
          "description": "Name of the SingleStore database to connect to"
        },
        "singlestore.useSSL": {
          "type": "boolean",
          "default": false,
          "description": "Enable SSL for the database connection"
        },
        "singlestore.schemaRefreshInterval": {
          "type": "number",
          "default": 5,
          "enum": [1, 5, 30, 60, 0],
          "enumDescriptions": ["Every minute", "Every 5 minutes", "Every 30 minutes", "Every hour", "Never"],
          "description": "Automatic database schema refresh interval in minutes. 0 disables periodic refresh; initial and manual refreshes remain available."
        },
        "singlestore.filePattern": {
          "type": "string",
          "scope": "application",
          "default": "*.s2db.sql",
          "minLength": 1,
          "description": "File glob for SingleStore SQL completions and language association. Examples: *.s2db.sql, *.sql, **/queries/*.sql. The extension manages the corresponding user files.associations entry without replacing existing associations."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test test/*.test.js",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "singlestore-nodejs": "^1.0.1"
  }
}
